@PACKAGE_INIT@

# The exported targets carry CUDAToolkit::cudart, CUDA::cublas and so on in their
# link interfaces, so the consumer needs those imported targets before the target
# file is read. Without this, find_package(nova) succeeded and then configure
# failed with "The link interface of target Nova::cuda_impl contains
# CUDAToolkit::cudart but the target was not found".
include(CMakeFindDependencyMacro)
find_dependency(CUDAToolkit)
# cuda_checkpoint links OpenSSL::Crypto, and cuda_comm/cuda_memory_error need
# Threads::Threads; both are exported in the link interface.
find_dependency(OpenSSL)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/NovaTargets.cmake")

check_required_components(nova)

# Feature matrix output. The conditions used to read NOVA_NCCL_ENABLED and
# NOVA_MPI_ENABLED, which nothing defines -- they are compile DEFINITIONS on a
# target, not configure variables -- so the message always took the else() branch
# and reported [OFF] for a build with NCCL linked in.
if(@NOVA_NCCL_ENABLED_AT_CONFIGURE@)
    message(STATUS "Nova @PROJECT_VERSION@: NCCL [ON]")
else()
    message(STATUS "Nova @PROJECT_VERSION@: NCCL [OFF]")
endif()

if(@NOVA_MPI_ENABLED_AT_CONFIGURE@)
    message(STATUS "Nova @PROJECT_VERSION@: MPI [ON]")
else()
    message(STATUS "Nova @PROJECT_VERSION@: MPI [OFF]")
endif()

message(STATUS "Nova @PROJECT_VERSION@: CUDA @CMAKE_CUDA_COMPILER_VERSION@")
message(STATUS "Nova @PROJECT_VERSION@: Build type: @CMAKE_BUILD_TYPE@")
