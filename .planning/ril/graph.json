    "decision-matmul-thread-per-rank": {
      "id": "decision-matmul-thread-per-rank",
      "type": "decision",
      "status": "active",
      "version": 1,
      "created_at": "2026-08-11T07:48:58+00:00",
      "updated_at": "2026-08-11T07:48:58+00:00",
      "touched_round": 15,
      "rationale": "Distributed matmul multi-GPU path does NOT require separate OS processes: genuine multi-device NCCL collectives run correctly thread-per-rank (one thread per device, cudaSetDevice per thread) in a single process, exactly as the R15 NCCL collective suite proved (14/14) and as cpp-reviewer validated. Implemented matmul_multi_gpu (row-split + NcclAllGather) and tested it thread-per-rank; avoids fork/exec complexity and CUDA-fork hazards.",
      "alternatives_rejected": "process-per-rank harness (fork/exec CSP); multi-process NCCL bootstrap via ncclGetUniqueId env passing"
    },
